    {
      "definition": {
        "title": "Nodos del VMSS (agente de Datadog)",
        "type": "group",
        "background_color": "vivid_green",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "CPU por nodo (%)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "i",
                      "data_source": "metrics",
                      "query": "avg:system.cpu.idle{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 - i",
                      "alias": "CPU usada"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "yaxis": {
                "min": "0",
                "max": "100"
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Memoria usada por nodo (%)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "u",
                      "data_source": "metrics",
                      "query": "avg:system.mem.pct_usable{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * (1 - u)",
                      "alias": "memoria usada"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
