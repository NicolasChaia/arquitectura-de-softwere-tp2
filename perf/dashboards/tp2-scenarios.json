                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "% de validaciones con error",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "e",
                      "data_source": "metrics",
                      "query": "sum:exchange.arca.validation.error{$host}.as_count()"
                    },
                    {
                      "name": "o",
                      "data_source": "metrics",
                      "query": "sum:exchange.arca.validation.approved{$host}.as_count()"
                    },
                    {
                      "name": "r",
                      "data_source": "metrics",
                      "query": "sum:exchange.arca.validation.rejected{$host}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * e / (e + o + r)",
