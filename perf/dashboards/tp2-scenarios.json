{
  "title": "TP2 - arVault en Azure (pruebas de carga)",
  "description": "Escenario: filtrar con la variable test (tag test:<escenario> de los YAML de perf/). Nodos: variable host. Latencias de Artillery incluyen la latencia de base L (generador fuera de Azure).",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "test",
      "prefix": "test",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "host",
      "prefix": "host",
      "available_values": [],
      "default": "*"
    }
  ],
  "notify_list": [],
  "widgets": [
    {
      "definition": {
        "title": "Carga (Artillery, desde el generador)",
        "type": "group",
        "background_color": "vivid_blue",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Throughput (req/s)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "q1",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.requests{$test}.as_rate()"
                    },
                    {
                      "name": "q2",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.responses{$test}.as_rate()"
                    },
                    {
                      "name": "q3",
                      "data_source": "metrics",
                      "query": "avg:artillery.http.request_rate{$test}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "requests enviados/s"
                    },
                    {
                      "formula": "q2",
                      "alias": "respuestas/s"
                    },
                    {
                      "formula": "q3",
                      "alias": "request_rate (Artillery)"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Latencia vista por el cliente (ms, incluye L)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "q1",
                      "data_source": "metrics",
                      "query": "avg:artillery.http.response_time.median{$test}"
                    },
                    {
                      "name": "q2",
                      "data_source": "metrics",
                      "query": "avg:artillery.http.response_time.p95{$test}"
                    },
                    {
                      "name": "q3",
                      "data_source": "metrics",
                      "query": "avg:artillery.http.response_time.p99{$test}"
                    },
                    {
                      "name": "q4",
                      "data_source": "metrics",
                      "query": "max:artillery.http.response_time.max{$test}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "mediana"
                    },
                    {
                      "formula": "q2",
                      "alias": "p95"
                    },
                    {
                      "formula": "q3",
                      "alias": "p99"
                    },
                    {
                      "formula": "q4",
                      "alias": "max"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Códigos HTTP (por intervalo)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "c200",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.200{$test}.as_count()"
                    },
                    {
                      "name": "c400",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.400{$test}.as_count()"
                    },
                    {
                      "name": "c403",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.403{$test}.as_count()"
                    },
                    {
                      "name": "c409",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.409{$test}.as_count()"
                    },
                    {
                      "name": "c429",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.429{$test}.as_count()"
                    },
                    {
                      "name": "c500",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.500{$test}.as_count()"
                    },
                    {
                      "name": "c503",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.503{$test}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "c200",
                      "alias": "200"
                    },
                    {
                      "formula": "c400",
                      "alias": "400"
                    },
                    {
                      "formula": "c403",
                      "alias": "403"
                    },
                    {
                      "formula": "c409",
                      "alias": "409"
                    },
                    {
                      "formula": "c429",
                      "alias": "429"
                    },
                    {
                      "formula": "c500",
                      "alias": "500"
                    },
                    {
                      "formula": "c503",
                      "alias": "503"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Errores del cliente (sin respuesta HTTP)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "q1",
                      "data_source": "metrics",
                      "query": "sum:artillery.errors.ETIMEDOUT{$test}.as_count()"
                    },
                    {
                      "name": "q2",
                      "data_source": "metrics",
                      "query": "sum:artillery.errors.ECONNRESET{$test}.as_count()"
                    },
                    {
                      "name": "q3",
                      "data_source": "metrics",
                      "query": "sum:artillery.errors.ECONNREFUSED{$test}.as_count()"
                    },
                    {
                      "name": "q4",
                      "data_source": "metrics",
                      "query": "sum:artillery.vusers.failed{$test}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "ETIMEDOUT"
                    },
                    {
                      "formula": "q2",
                      "alias": "ECONNRESET"
                    },
                    {
                      "formula": "q3",
                      "alias": "ECONNREFUSED"
                    },
                    {
                      "formula": "q4",
                      "alias": "VUs fallidos"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Tasa de errores del sistema (%) = 5xx + errores de conexión / requests",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "a",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.500{$test}.as_count()"
                    },
                    {
                      "name": "b",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.codes.503{$test}.as_count()"
                    },
                    {
                      "name": "c",
                      "data_source": "metrics",
                      "query": "sum:artillery.vusers.failed{$test}.as_count()"
                    },
                    {
                      "name": "r",
                      "data_source": "metrics",
                      "query": "sum:artillery.http.requests{$test}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * (a + b + c) / r",
                      "alias": "% errores"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 3
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Servidor (tiempo dentro del nodo, sin internet)",
        "type": "group",
        "background_color": "vivid_orange",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "POST /exchange: latencia en el servidor (ms)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "q1",
                      "data_source": "metrics",
                      "query": "avg:exchange.http.response_time.median{$host,route:/exchange}"
                    },
                    {
                      "name": "q2",
                      "data_source": "metrics",
                      "query": "avg:exchange.http.response_time.95percentile{$host,route:/exchange}"
                    },
                    {
                      "name": "q3",
                      "data_source": "metrics",
                      "query": "max:exchange.http.response_time.max{$host,route:/exchange}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "mediana"
                    },
                    {
                      "formula": "q2",
                      "alias": "p95"
                    },
                    {
                      "formula": "q3",
                      "alias": "max"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Mediana en el servidor por ruta y código (ms)",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "name": "q1",
                      "data_source": "metrics",
                      "query": "avg:exchange.http.response_time.median{$host} by {route,status}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1",
                      "alias": "mediana"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      }
    },
    {
